<?xml version="1.0" encoding="utf-8" ?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!-- root element -->
	<xs:element name="NationalParks">
		<xs:complexType>
			<xs:sequence>

				<xs:element name="NationalPark"
							minOccurs="1"
							maxOccurs="unbounded">

					<xs:complexType>
						<xs:sequence>

							<!-- national park name -->
							<xs:element name="Name"
										type="xs:string" />
							<!-- phone numbers for the national park-->
							<xs:element name="Phone"
										type="xs:string"
										minOccurs="1"
										maxOccurs="unbounded" />
							<!-- address of the national park -->
							<xs:element name="Address">
								<xs:complexType>
									<xs:sequence>

										<xs:element name="Number"
													type="xs:integer" />
										<xs:element name="Street"
													type="xs:string" />
										<xs:element name="City"
													type="xs:string" />
										<xs:element name="State"
													type="xs:string" />
										<xs:element name="Zip"
													type="xs:integer" />

									</xs:sequence>
									<!-- closest airport to the national park -->
									<xs:attribute name="NearestAirport"
												  type="xs:string"
												  use="required" />

								</xs:complexType>
							</xs:element>

						</xs:sequence>
						<!-- rating of the national park -->
						<xs:attribute name="Rating"
									  type="xs:decimal"
									  use="optional" />

					</xs:complexType>
				</xs:element>

			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>